rules_version = '2';

// ============================================================================
// Règles de sécurité Firestore — Car'Tech Arena
//
// À copier-coller dans : Firebase Console > Build > Firestore Database
//                          > onglet "Règles" > remplacer tout le contenu > Publier
//
// Pourquoi ces règles existent : le code du site décide côté client si un
// compte est "joueur" ou "organisateur", et quelles décorations/thèmes il
// possède, mais un client peut toujours être modifié par quelqu'un de
// malintentionné (via les outils développeur du navigateur). Ces règles
// revérifient donc TOUJOURS côté serveur :
//   - qu'un compte ne peut devenir "organisateur" que s'il correspond à
//     l'adresse ci-dessous (remplace-la si tu changes ORGANIZER_EMAIL dans
//     js/firebase-config.js),
//   - qu'un joueur ne peut jamais changer son propre rôle, ses points, ou
//     s'attribuer lui-même une décoration/un thème verrouillé,
//   - que seul l'organisateur peut attribuer des décorations et des thèmes
//     "Trophée" à un autre compte.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Fonction utilitaire : est-ce que 2 résultats de duel concordent ?
    // Chaque joueur saisit SON propre résultat sous la forme
    // { myScore, oppScore, iWon }. Ça concorde si les scores sont
    // symétriques (mon score = son "score adverse" vu par l'autre, et
    // inversement) et si un seul des deux dit avoir gagné.
    // --------------------------------------------------------------------
    function matchResults(rf, rt) {
      return rf != null && rt != null
        && rf.myScore == rt.oppScore
        && rf.oppScore == rt.myScore
        && rf.iWon == !rt.iWon;
    }

    function isOrganizer() {
      return request.auth != null
        && request.auth.token.email.lower() == 'cartechsf79@gmail.com';
    }

    // --------------------------------------------------------------------
    // Tags de profil : jusqu'à 5 affichés en même temps ("active"). Un tag
    // est utilisable soit parce qu'il est explicitement dans "owned" (donné
    // par l'organisateur), soit parce qu'il est marqué "défaut" par
    // l'organisateur (disponible pour tout le monde dès sa création, sans
    // avoir besoin d'être ajouté à "owned" individuellement). Bornée à 5
    // vérifications fixes, comme allGamesMatch plus haut, car les règles
    // Firestore ne permettent pas de boucler sur une liste de taille libre.
    // --------------------------------------------------------------------
    function tagUsable(tagId, owned) {
      return tagId in owned
        || (exists(/databases/$(database)/documents/tags/$(tagId))
            && get(/databases/$(database)/documents/tags/$(tagId)).data.defaultOwned == true);
    }
    function tagsActiveValid(active, owned) {
      return active is list && active.size() <= 5
        && (active.size() < 1 || tagUsable(active[0], owned))
        && (active.size() < 2 || tagUsable(active[1], owned))
        && (active.size() < 3 || tagUsable(active[2], owned))
        && (active.size() < 4 || tagUsable(active[3], owned))
        && (active.size() < 5 || tagUsable(active[4], owned));
    }

    // --------------------------------------------------------------------
    // Fonctions utilitaires pour les matchs d'Événement : un match se joue
    // en plusieurs manches (1/3/5 selon bo1/bo3/bo5), chaque joueur envoie
    // TOUT son tableau de résultats en un seul coup (jamais rempli à
    // moitié), donc on compare 2 tableaux de même taille, indice par
    // indice (bornée à 5 car aucun format ne dépasse le bo5).
    // --------------------------------------------------------------------
    function gameMatches(g1, g2) {
      return g1 != null && g2 != null
        && g1.myScore == g2.oppScore
        && g1.oppScore == g2.myScore
        && g1.iWon == !g2.iWon;
    }
    function allGamesMatch(list1, list2) {
      return list1 != null && list2 != null && list1.size() == list2.size()
        && (list1.size() < 1 || gameMatches(list1[0], list2[0]))
        && (list1.size() < 2 || gameMatches(list1[1], list2[1]))
        && (list1.size() < 3 || gameMatches(list1[2], list2[2]))
        && (list1.size() < 4 || gameMatches(list1[3], list2[3]))
        && (list1.size() < 5 || gameMatches(list1[4], list2[4]));
    }
    function allGamesFilled(list, expectedSize) {
      return list != null && list.size() == expectedSize
        && (list.size() < 1 || list[0] != null)
        && (list.size() < 2 || list[1] != null)
        && (list.size() < 3 || list[2] != null)
        && (list.size() < 4 || list[3] != null)
        && (list.size() < 5 || list[4] != null);
    }

    match /users/{userId} {

      // Tout compte connecté peut lire les profils (classement, recherche
      // d'un joueur, affichage de son profil).
      allow read: if request.auth != null;

      // Création : uniquement son propre document, avec un rôle cohérent et
      // aucune décoration débloquée d'office (les décorations sont toujours
      // attribuées après coup par l'organisateur, jamais à la création).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.decorations.owned.size() == 0
        && request.resource.data.decorations.active == null
        && (!('tags' in request.resource.data)
            || (request.resource.data.tags.owned.size() == 0 && request.resource.data.tags.active.size() == 0))
        && (
          (request.resource.data.role == 'organisateur'
            && request.auth.token.email.lower() == 'cartechsf79@gmail.com')
          || request.resource.data.role == 'joueur'
        );

      // Mise à jour :
      //  - l'organisateur peut tout modifier sur n'importe quel compte
      //    (attribution de décorations/thèmes, modération) ;
      //  - un joueur peut modifier son propre document (pseudo, mot de passe
      //    -- géré par Firebase Auth --, photo, décoration/thème ACTIFS),
      //    mais jamais son rôle, ses points/victoires/défaites, ni les
      //    listes de décorations/thèmes qu'il possède. Il ne peut choisir
      //    comme actif qu'une décoration/un thème qu'il possède déjà.
      allow update: if request.auth != null && (
        request.auth.token.email.lower() == 'cartechsf79@gmail.com'
        ||
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.points == resource.data.points
          && request.resource.data.wins == resource.data.wins
          && request.resource.data.losses == resource.data.losses
          && (!('decorations' in resource.data) || request.resource.data.decorations.owned == resource.data.decorations.owned)
          && (!('theme' in resource.data) || request.resource.data.theme.owned == resource.data.theme.owned)
          && (!('tags' in resource.data) || request.resource.data.tags.owned == resource.data.tags.owned)
          && (request.resource.data.decorations.active == null
              || request.resource.data.decorations.active in request.resource.data.decorations.owned)
          && (request.resource.data.theme.active in request.resource.data.theme.owned)
          && (!('tags' in request.resource.data)
              || tagsActiveValid(request.resource.data.tags.active, request.resource.data.tags.owned))
        )
      );

      // Un compte peut supprimer son propre profil (bouton "Supprimer mon
      // compte"). L'organisateur ne supprime pas de compte depuis le site
      // pour l'instant (à faire depuis la console Firebase si nécessaire).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================================================
    // Catalogues créés par l'organisateur : décorations de photo de profil
    // (statiques ou animées), thèmes personnalisés, tags de profil. Tout le
    // monde peut les lire (nécessaire pour afficher les décorations/thèmes/
    // tags des autres joueurs) ; seul l'organisateur les crée ou les modifie.
    // Pas de suppression pour l'instant, pour ne jamais laisser un joueur
    // avec une référence vers un catalogue supprimé.
    // ========================================================================
    match /decorations/{decoId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if false;
    }

    match /themes/{themeId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if false;
    }

    match /tags/{tagId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if false;
    }

    // ========================================================================
    // "Duel du jour" — session de duels en boutique, gérée en direct.
    //
    //   dailySession/current                      -> statut de la soirée
    //   dailySession/current/participants/{uid}    -> présence + validation
    //   dailySession/current/duels/{duelId}        -> propositions + résultats
    // ========================================================================

    match /dailySession/{sessionId} {
      // Tout le monde peut voir si une session est ouverte / son heure de fin.
      allow read: if request.auth != null;
      // Seul l'organisateur ouvre / ferme la session (et fixe l'heure de fin).
      allow write: if isOrganizer();
    }

    match /dailySession/{sessionId}/participants/{uid} {
      allow read: if request.auth != null;

      // Un joueur ne peut créer que SA propre demande, toujours en attente de
      // validation par l'organisateur. L'organisateur peut créer directement
      // sa propre fiche déjà "disponible" (il n'a pas besoin de s'auto-valider).
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.status == 'attente_validation')
        || isOrganizer()
      );

      // L'organisateur gère tout (valider/refuser/exclure). Un joueur peut
      // seulement : se retirer lui-même ("Quitter le duel du jour"), sans
      // toucher à ses propres pseudo/photo/décorations affichés dans la
      // liste ; OU redemander à rejoindre après un départ / refus /
      // exclusion (repasse en attente de validation par l'organisateur).
      allow update: if isOrganizer() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && (
          (
            resource.data.status in ['attente_validation', 'disponible']
            && request.resource.data.status == 'parti'
            && request.resource.data.pseudo == resource.data.pseudo
            && request.resource.data.photoDataUrl == resource.data.photoDataUrl
            && request.resource.data.decorations == resource.data.decorations
          )
          ||
          (
            resource.data.status in ['parti', 'refuse', 'exclu']
            && request.resource.data.status == 'attente_validation'
          )
        )
      );

      allow delete: if isOrganizer();
    }

    match /dailySession/{sessionId}/duels/{duelId} {
      // Lecture ouverte à tous les connectés : nécessaire pour que chacun
      // puisse calculer, côté client, qui est déjà occupé par un autre duel.
      allow read: if request.auth != null;

      // Seul l'auteur de la proposition peut la créer, ciblant quelqu'un
      // d'autre, sans résultat déjà rempli.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.status == 'proposition'
        && request.resource.data.resultFrom == null
        && request.resource.data.resultTo == null;

      allow update: if isOrganizer() || (
        // Le destinataire accepte ou refuse la proposition.
        request.auth != null && request.auth.uid == resource.data.toUid
        && resource.data.status == 'proposition'
        && request.resource.data.status in ['en_cours', 'refuse']
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.game == resource.data.game
        && request.resource.data.format == resource.data.format
        && request.resource.data.resultFrom == null
        && request.resource.data.resultTo == null
      ) || (
        // Le joueur "fromUid" saisit / corrige SON résultat uniquement.
        request.auth != null && request.auth.uid == resource.data.fromUid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.resultTo == resource.data.resultTo
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == (
             matchResults(request.resource.data.resultFrom, resource.data.resultTo)
               ? 'termine'
               : (resource.data.resultTo == null ? 'en_cours' : 'litige')
           )
      ) || (
        // Le joueur "toUid" saisit / corrige SON résultat uniquement.
        request.auth != null && request.auth.uid == resource.data.toUid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.resultFrom == resource.data.resultFrom
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == (
             matchResults(resource.data.resultFrom, request.resource.data.resultTo)
               ? 'termine'
               : (resource.data.resultFrom == null ? 'en_cours' : 'litige')
           )
      );

      allow delete: if isOrganizer();
    }

    // ========================================================================
    // "Événement" — tournoi façon suisse, géré en direct.
    //
    //   events/{eventId}                     -> config + statut de l'événement
    //   events/{eventId}/participants/{uid}   -> inscription + validation
    //   events/{eventId}/matches/{matchId}    -> appariements + résultats
    // ========================================================================

    match /events/{eventId} {
      // Tout le monde peut voir les événements (en cours ou passés, pour
      // l'historique).
      allow read: if request.auth != null;
      // Seul l'organisateur crée / démarre / fait avancer / termine un
      // événement.
      allow create, update, delete: if isOrganizer();
    }

    match /events/{eventId}/participants/{uid} {
      allow read: if request.auth != null;

      // Un joueur ne peut créer que SA propre inscription, toujours en
      // liste d'attente. L'organisateur peut inscrire directement quelqu'un
      // (déjà "inscrit").
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.status == 'liste_attente')
        || isOrganizer()
      );

      // Même logique que pour le Duel du jour : l'organisateur gère tout
      // (valider/refuser/exclure/attribuer une place finale) ; un joueur
      // peut seulement se retirer, ou redemander à s'inscrire après un
      // départ / refus / exclusion. Victoires/défaites ne sont jamais
      // stockées ici (calculées à partir de l'historique des matchs), donc
      // pas besoin de les protéger ; la place finale ("placement") ne doit
      // en revanche jamais bouger via une action joueur.
      allow update: if isOrganizer() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.placement == resource.data.placement
        && (
          (
            resource.data.status in ['liste_attente', 'inscrit']
            && request.resource.data.status == 'parti'
            && request.resource.data.pseudo == resource.data.pseudo
            && request.resource.data.photoDataUrl == resource.data.photoDataUrl
            && request.resource.data.decorations == resource.data.decorations
          )
          ||
          (
            resource.data.status in ['parti', 'refuse', 'exclu']
            && request.resource.data.status == 'liste_attente'
          )
        )
      );

      allow delete: if isOrganizer();
    }

    match /events/{eventId}/matches/{matchId} {
      // Lecture ouverte : nécessaire pour que chacun voie les appariements
      // et l'avancement du tournoi.
      allow read: if request.auth != null;

      // Les appariements ne sont créés que par l'organisateur (démarrage de
      // l'événement / manche suivante).
      allow create: if isOrganizer();

      allow update: if isOrganizer() || (
        // Le joueur 1 saisit / corrige SON tableau de résultats uniquement.
        request.auth != null && request.auth.uid == resource.data.player1Uid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.gamesResult2 == resource.data.gamesResult2
        && (
             request.resource.data.gamesResult1 == null
             || allGamesFilled(request.resource.data.gamesResult1, resource.data.gamesCount)
           )
        && request.resource.data.status == (
             allGamesMatch(request.resource.data.gamesResult1, resource.data.gamesResult2)
               ? 'termine'
               : (resource.data.gamesResult2 == null ? 'en_cours' : 'litige')
           )
      ) || (
        // Le joueur 2 saisit / corrige SON tableau de résultats uniquement.
        request.auth != null && request.auth.uid == resource.data.player2Uid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.gamesResult1 == resource.data.gamesResult1
        && (
             request.resource.data.gamesResult2 == null
             || allGamesFilled(request.resource.data.gamesResult2, resource.data.gamesCount)
           )
        && request.resource.data.status == (
             allGamesMatch(resource.data.gamesResult1, request.resource.data.gamesResult2)
               ? 'termine'
               : (resource.data.gamesResult1 == null ? 'en_cours' : 'litige')
           )
      );

      allow delete: if isOrganizer();
    }
  }
}
