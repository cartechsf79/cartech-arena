rules_version = '2';

// ============================================================================
// Règles de sécurité Firestore — Car'Tech Arena
//
// À copier-coller dans : Firebase Console > Build > Firestore Database
//                          > onglet "Règles" > remplacer tout le contenu > Publier
//
// Pourquoi ces règles existent : le code du site décide côté client si un
// compte est "joueur" ou "organisateur", et quelles décorations/thèmes il
// possède, mais un client peut toujours être modifié par quelqu'un de
// malintentionné (via les outils développeur du navigateur). Ces règles
// revérifient donc TOUJOURS côté serveur :
//   - qu'un compte ne peut devenir "organisateur" que s'il correspond à
//     l'adresse ci-dessous (remplace-la si tu changes ORGANIZER_EMAIL dans
//     js/firebase-config.js),
//   - qu'un joueur ne peut jamais changer son propre rôle, ses points, ou
//     s'attribuer lui-même une décoration/un thème verrouillé,
//   - que seul l'organisateur peut attribuer des décorations et des thèmes
//     "Trophée" à un autre compte.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Fonction utilitaire : est-ce que 2 résultats de duel concordent ?
    // Chaque joueur saisit SON propre résultat sous la forme
    // { myScore, oppScore, iWon }. Ça concorde si les scores sont
    // symétriques (mon score = son "score adverse" vu par l'autre, et
    // inversement) et si un seul des deux dit avoir gagné.
    // --------------------------------------------------------------------
    function matchResults(rf, rt) {
      return rf != null && rt != null
        && rf.myScore == rt.oppScore
        && rf.oppScore == rt.myScore
        && rf.iWon == !rt.iWon;
    }

    function isOrganizer() {
      return request.auth != null
        && request.auth.token.email.lower() == 'cartechsf79@gmail.com';
    }

    // --------------------------------------------------------------------
    // Tags de profil : jusqu'à 5 affichés en même temps ("active"). Un tag
    // est utilisable soit parce qu'il est explicitement dans "owned" (donné
    // par l'organisateur), soit parce qu'il est marqué "défaut" par
    // l'organisateur (disponible pour tout le monde dès sa création, sans
    // avoir besoin d'être ajouté à "owned" individuellement). Bornée à 5
    // vérifications fixes, comme allGamesMatch plus haut, car les règles
    // Firestore ne permettent pas de boucler sur une liste de taille libre.
    // --------------------------------------------------------------------
    function tagUsable(tagId, owned) {
      return tagId in owned
        || (exists(/databases/$(database)/documents/tags/$(tagId))
            && get(/databases/$(database)/documents/tags/$(tagId)).data.defaultOwned == true);
    }
    function tagsActiveValid(active, owned) {
      return active is list && active.size() <= 5
        && (active.size() < 1 || tagUsable(active[0], owned))
        && (active.size() < 2 || tagUsable(active[1], owned))
        && (active.size() < 3 || tagUsable(active[2], owned))
        && (active.size() < 4 || tagUsable(active[3], owned))
        && (active.size() < 5 || tagUsable(active[4], owned));
    }

    // --------------------------------------------------------------------
    // Tag de saison : un joueur peut se l'attribuer TOUT SEUL (sans passer
    // par l'organisateur) dès qu'il a joué un duel pendant la saison en
    // cours — voir js/season.js. On ne fait confiance au client que dans
    // une mesure très étroite : la seule chose qu'un joueur peut faire ici,
    // c'est AJOUTER (jamais retirer/réordonner) exactement UN tag déjà
    // marqué "autoGrant:true" par l'organisateur (créé automatiquement en
    // même temps que la saison, voir /seasons plus bas) — un joueur ne peut
    // toujours pas s'attribuer un tag "normal" (récompense manuelle) de
    // cette façon.
    // --------------------------------------------------------------------
    function tagAutoGrantable(tagId) {
      return exists(/databases/$(database)/documents/tags/$(tagId))
        && get(/databases/$(database)/documents/tags/$(tagId)).data.get('autoGrant', false) == true;
    }
    function isValidSelfSeasonTagGrant(oldOwned, newOwned) {
      return newOwned.size() == oldOwned.size() + 1
        && newOwned == oldOwned.concat([newOwned[newOwned.size() - 1]])
        && !(newOwned[newOwned.size() - 1] in oldOwned)
        && tagAutoGrantable(newOwned[newOwned.size() - 1]);
    }

    // --------------------------------------------------------------------
    // Système de parrainage : un joueur peut renseigner, une seule fois et
    // jamais changer ensuite, le pseudo (converti en uid) de la personne qui
    // l'a parrainé (voir js/app.js, modale à l'inscription). Une fois que ce
    // filleul termine son PREMIER duel du jour jamais joué, les DEUX comptes
    // reçoivent un tag récompense marqué "referralReward:true" par
    // l'organisateur (voir js/settings.js, case à cocher dans la création
    // d'un tag) — même esprit que le tag de saison auto-attribué ci-dessus,
    // mais avec en plus une écriture CROISÉE vers le compte du parrain (voir
    // isValidCrossReferralGrant plus bas), puisque ce n'est pas son propre
    // compte qui déclenche l'action.
    // --------------------------------------------------------------------
    function tagIsReferralReward(tagId) {
      return exists(/databases/$(database)/documents/tags/$(tagId))
        && get(/databases/$(database)/documents/tags/$(tagId)).data.get('referralReward', false) == true;
    }
    function isValidSelfReferralTagGrant(oldOwned, newOwned) {
      return newOwned.size() == oldOwned.size() + 1
        && newOwned == oldOwned.concat([newOwned[newOwned.size() - 1]])
        && !(newOwned[newOwned.size() - 1] in oldOwned)
        && tagIsReferralReward(newOwned[newOwned.size() - 1]);
    }
    // Écriture croisée vers le compte du PARRAIN (userId ici = le parrain,
    // pas la personne connectée) : seulement possible si MON propre document
    // (request.auth.uid, le filleul) prouve que "userId" est bien mon
    // parrain, et seulement pour ajouter EXACTEMENT le tag de récompense à
    // "tags.owned" — rien d'autre sur le document du parrain ne peut bouger
    // (vérifié via diff().affectedKeys(), qui ne doit contenir que "tags",
    // et tags.active doit rester inchangé lui aussi).
    function isValidCrossReferralGrant(userId) {
      let oldOwned = resource.data.get('tags', {}).get('owned', []);
      let newOwned = request.resource.data.get('tags', {}).get('owned', []);
      return request.auth != null
        && request.auth.uid != userId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('referral', {}).get('referredByUid', null) == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags'])
        && request.resource.data.get('tags', {}).get('active', []) == resource.data.get('tags', {}).get('active', [])
        && newOwned.size() == oldOwned.size() + 1
        && newOwned == oldOwned.concat([newOwned[newOwned.size() - 1]])
        && !(newOwned[newOwned.size() - 1] in oldOwned)
        && tagIsReferralReward(newOwned[newOwned.size() - 1]);
    }

    // --------------------------------------------------------------------
    // Succès (achievements) : le catalogue des succès (paliers, tags et
    // titres qu'ils rapportent) vit uniquement côté client (voir
    // js/achievements.js) — pas de document Firestore par succès, donc pas
    // d'exists()/get() possible pour vérifier la légitimité comme pour les
    // tags de saison/parrainage ci-dessus. À la place, on réserve un espace
    // de noms d'ids ("ach_tag_"/"ach_title_", jamais produit par un id
    // auto-généré d'un tag/titre créé par l'organisateur) et on n'autorise,
    // comme pour les tags de saison/parrainage, que l'ajout d'EXACTEMENT un
    // id de ce type à la fois (jamais un retrait, jamais un id "normal") —
    // un joueur qui débloque plusieurs paliers d'un coup (ex: à la toute
    // première ouverture de l'écran Succès après la mise en ligne de cette
    // fonctionnalité) reçoit donc plusieurs écritures successives, une par
    // tag/titre, jamais une seule écriture groupée. Comme pour tout ce
    // système basé sur des scores auto-déclarés par les duels, on fait
    // confiance au client sur la CONDITION elle-même (avoir vraiment joué
    // 500 duels, etc.) — seule la structure de l'écriture est vérifiée ici,
    // exactement comme pour les scores de duel.
    // --------------------------------------------------------------------
    function tagIsAchievementGrantable(tagId) {
      return tagId.matches('^ach_tag_.*');
    }
    function isValidSelfAchievementTagGrant(oldOwned, newOwned) {
      return newOwned.size() == oldOwned.size() + 1
        && newOwned == oldOwned.concat([newOwned[newOwned.size() - 1]])
        && !(newOwned[newOwned.size() - 1] in oldOwned)
        && tagIsAchievementGrantable(newOwned[newOwned.size() - 1]);
    }
    function titleIsAchievementGrantable(titleId) {
      return titleId.matches('^ach_title_.*');
    }
    function isValidSelfAchievementTitleGrant(oldOwned, newOwned) {
      return newOwned.size() == oldOwned.size() + 1
        && newOwned == oldOwned.concat([newOwned[newOwned.size() - 1]])
        && !(newOwned[newOwned.size() - 1] in oldOwned)
        && titleIsAchievementGrantable(newOwned[newOwned.size() - 1]);
    }

    // --------------------------------------------------------------------
    // Calendrier des tournois (Task #44) : de simples annonces "date + jeu"
    // totalement indépendantes des vrais événements (voir events/{eventId}
    // plus bas) — aucune validation par l'organisateur nécessaire ici,
    // n'importe quel compte connecté peut juste dire "je suis intéressé"
    // en ajoutant SON PROPRE uid au tableau "interested", ou le retirer.
    // hasAll()/in (plutôt qu'une égalité stricte sur le tableau) pour rester
    // correct quel que soit l'ordre interne du tableau après un
    // arrayUnion/arrayRemove côté client.
    // --------------------------------------------------------------------
    function onlyToggledOwnInterest(uid) {
      let oldInterested = resource.data.get('interested', []);
      let newInterested = request.resource.data.get('interested', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interested'])
        && (
          (newInterested.size() == oldInterested.size() + 1
            && newInterested.hasAll(oldInterested)
            && (uid in newInterested) && !(uid in oldInterested))
          ||
          (oldInterested.size() == newInterested.size() + 1
            && oldInterested.hasAll(newInterested)
            && (uid in oldInterested) && !(uid in newInterested))
        );
    }

    // --------------------------------------------------------------------
    // Fonctions utilitaires pour les matchs d'Événement : un match se joue
    // en plusieurs manches (1/3/5 selon bo1/bo3/bo5), chaque joueur envoie
    // TOUT son tableau de résultats en un seul coup (jamais rempli à
    // moitié), donc on compare 2 tableaux de même taille, indice par
    // indice (bornée à 5 car aucun format ne dépasse le bo5).
    // --------------------------------------------------------------------
    function gameMatches(g1, g2) {
      return g1 != null && g2 != null
        && g1.myScore == g2.oppScore
        && g1.oppScore == g2.myScore
        && g1.iWon == !g2.iWon;
    }
    function allGamesMatch(list1, list2) {
      return list1 != null && list2 != null && list1.size() == list2.size()
        && (list1.size() < 1 || gameMatches(list1[0], list2[0]))
        && (list1.size() < 2 || gameMatches(list1[1], list2[1]))
        && (list1.size() < 3 || gameMatches(list1[2], list2[2]))
        && (list1.size() < 4 || gameMatches(list1[3], list2[3]))
        && (list1.size() < 5 || gameMatches(list1[4], list2[4]));
    }
    function allGamesFilled(list, expectedSize) {
      return list != null && list.size() == expectedSize
        && (list.size() < 1 || list[0] != null)
        && (list.size() < 2 || list[1] != null)
        && (list.size() < 3 || list[2] != null)
        && (list.size() < 4 || list[3] != null)
        && (list.size() < 5 || list[4] != null);
    }

    match /users/{userId} {

      // Tout compte connecté peut lire les profils (classement, recherche
      // d'un joueur, affichage de son profil).
      allow read: if request.auth != null;

      // Création : uniquement son propre document, avec un rôle cohérent et
      // aucune décoration débloquée d'office (les décorations sont toujours
      // attribuées après coup par l'organisateur, jamais à la création).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.decorations.owned.size() == 0
        && request.resource.data.decorations.active == null
        && (!('tags' in request.resource.data)
            || (request.resource.data.tags.get('owned', []).size() == 0 && request.resource.data.tags.get('active', []).size() == 0))
        // Même règle que les décorations, mais écrite avec .get() (valeur par
        // défaut {}) plutôt que 'in' : un fond de profil aucun débloqué/actif
        // à la création, que le champ "profileBg" soit présent ou non dans
        // l'écriture — les deux passent.
        && request.resource.data.get('profileBg', {}).get('owned', []).size() == 0
        && request.resource.data.get('profileBg', {}).get('active', null) == null
        // Même règle, pour le titre personnalisé (voir /titles plus bas).
        && request.resource.data.get('title', {}).get('owned', []).size() == 0
        && request.resource.data.get('title', {}).get('active', null) == null
        // Parrainage (voir plus haut) : à la création, jamais déjà "rempli" —
        // le pseudo du parrain (converti en uid) n'est renseigné qu'ensuite,
        // via la modale d'inscription (voir js/app.js), jamais dans le même
        // appel que la création du compte.
        && request.resource.data.get('referral', {}).get('referredByUid', null) == null
        && request.resource.data.get('referral', {}).get('rewardGranted', false) == false
        && (
          (request.resource.data.role == 'organisateur'
            && request.auth.token.email.lower() == 'cartechsf79@gmail.com')
          || request.resource.data.role == 'joueur'
        );

      // Mise à jour :
      //  - l'organisateur peut tout modifier sur n'importe quel compte
      //    (attribution de décorations/thèmes, modération) ;
      //  - un joueur peut modifier son propre document (pseudo, mot de passe
      //    -- géré par Firebase Auth --, photo, décoration/thème ACTIFS),
      //    mais jamais son rôle, ses points/victoires/défaites, ni les
      //    listes de décorations/thèmes qu'il possède. Il ne peut choisir
      //    comme actif qu'une décoration/un thème qu'il possède déjà.
      allow update: if request.auth != null && (
        request.auth.token.email.lower() == 'cartechsf79@gmail.com'
        ||
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.points == resource.data.points
          && request.resource.data.wins == resource.data.wins
          && request.resource.data.losses == resource.data.losses
          // Tout ce qui suit utilise .get('clé', valeurParDéfaut) plutôt que
          // .clé directement : accéder à une clé absente d'une map avec la
          // notation .clé fait ÉCHOUER l'évaluation de la règle avec une
          // erreur (pas juste "null" comme en JavaScript) — et une erreur
          // ici bloque TOUT le document, pas seulement le champ concerné.
          // C'est arrivé en pratique : un joueur qui active un tag "par
          // défaut" avant d'avoir jamais reçu de tag de l'organisateur se
          // retrouve avec un champ "tags" qui contient "active" mais pas
          // "owned" (jamais initialisé) — et sans ce laisser-passer, ce
          // compte ne pouvait plus JAMAIS rien modifier, même sa photo ou
          // son thème. Avec .get(), une clé manquante vaut simplement sa
          // valeur par défaut, sans jamais faire planter la règle.
          && (!('decorations' in resource.data) || request.resource.data.decorations.get('owned', []) == resource.data.decorations.get('owned', []))
          && (!('theme' in resource.data) || request.resource.data.theme.get('owned', []) == resource.data.theme.get('owned', []))
          // Fond de profil : même "laisser-passer" que décorations/thème,
          // mais toujours avec .get('profileBg', {}) plutôt que 'in' — les
          // comptes créés avant cette version n'ont pas ce champ du tout,
          // et .get() avec valeur par défaut évite toute erreur d'évaluation
          // dans ce cas (voir le long commentaire ci-dessus sur .get()).
          && request.resource.data.get('profileBg', {}).get('owned', []) == resource.data.get('profileBg', {}).get('owned', [])
          // Titre personnalisé : même "laisser-passer" .get() que le fond de
          // profil ci-dessus (comptes créés avant cette version sans champ
          // "title" du tout).
          && (request.resource.data.get('title', {}).get('owned', []) == resource.data.get('title', {}).get('owned', [])
              || isValidSelfAchievementTitleGrant(resource.data.get('title', {}).get('owned', []), request.resource.data.get('title', {}).get('owned', [])))
          && (!('tags' in resource.data)
              || request.resource.data.tags.get('owned', []) == resource.data.tags.get('owned', [])
              || isValidSelfSeasonTagGrant(resource.data.tags.get('owned', []), request.resource.data.tags.get('owned', []))
              || isValidSelfReferralTagGrant(resource.data.tags.get('owned', []), request.resource.data.tags.get('owned', []))
              || isValidSelfAchievementTagGrant(resource.data.tags.get('owned', []), request.resource.data.tags.get('owned', [])))
          // Ces 3 invariants valident un NOUVEL "active" (il doit être dans
          // "owned"), mais laissent toujours passer une écriture qui ne
          // touche pas du tout à ce champ-là (comparaison à la valeur
          // précédente, inchangée). Sans ce "laisser-passer", si
          // l'organisateur retire une décoration/un thème/un tag qui était
          // actif chez un joueur, ce joueur ne pourrait plus JAMAIS
          // remodifier son propre document (même un champ sans rapport),
          // car ces règles s'appliquent au document entier à chaque
          // écriture, pas seulement aux champs modifiés.
          && (request.resource.data.decorations.get('active', null) == null
              || request.resource.data.decorations.get('active', null) in request.resource.data.decorations.get('owned', [])
              || request.resource.data.decorations.get('active', null) == resource.data.decorations.get('active', null))
          && (request.resource.data.theme.get('active', 'classique') in request.resource.data.theme.get('owned', [])
              || request.resource.data.theme.get('active', 'classique') == resource.data.theme.get('active', 'classique'))
          && (request.resource.data.get('profileBg', {}).get('active', null) == null
              || request.resource.data.get('profileBg', {}).get('active', null) in request.resource.data.get('profileBg', {}).get('owned', [])
              || request.resource.data.get('profileBg', {}).get('active', null) == resource.data.get('profileBg', {}).get('active', null))
          && (request.resource.data.get('title', {}).get('active', null) == null
              || request.resource.data.get('title', {}).get('active', null) in request.resource.data.get('title', {}).get('owned', [])
              || request.resource.data.get('title', {}).get('active', null) == resource.data.get('title', {}).get('active', null))
          && (!('tags' in request.resource.data)
              || tagsActiveValid(request.resource.data.tags.get('active', []), request.resource.data.tags.get('owned', []))
              || request.resource.data.tags.get('active', []) == resource.data.tags.get('active', []))
          // Parrainage : "referredByUid" ne peut être défini QU'UNE FOIS
          // (null -> un uid existant, jamais l'inverse ni un changement une
          // fois posé), jamais vers soi-même. "rewardGranted" ne peut passer
          // de faux à vrai qu'en même temps qu'on s'ajoute le tag de
          // récompense (voir isValidSelfReferralTagGrant plus haut), et
          // seulement si un parrain est déjà enregistré.
          && (request.resource.data.get('referral', {}).get('referredByUid', null) == resource.data.get('referral', {}).get('referredByUid', null)
              || (resource.data.get('referral', {}).get('referredByUid', null) == null
                  && request.resource.data.get('referral', {}).get('referredByUid', null) != null
                  && request.resource.data.get('referral', {}).get('referredByUid', null) != request.auth.uid
                  && exists(/databases/$(database)/documents/users/$(request.resource.data.referral.referredByUid))))
          && (request.resource.data.get('referral', {}).get('rewardGranted', false) == resource.data.get('referral', {}).get('rewardGranted', false)
              || (resource.data.get('referral', {}).get('rewardGranted', false) == false
                  && request.resource.data.get('referral', {}).get('rewardGranted', false) == true
                  && request.resource.data.get('referral', {}).get('referredByUid', null) != null
                  && isValidSelfReferralTagGrant(resource.data.get('tags', {}).get('owned', []), request.resource.data.get('tags', {}).get('owned', []))))
        )
        || isValidCrossReferralGrant(userId)
      );

      // Un compte peut supprimer son propre profil (bouton "Supprimer mon
      // compte"). L'organisateur ne supprime pas de compte depuis le site
      // pour l'instant (à faire depuis la console Firebase si nécessaire).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================================================
    // Catalogues créés par l'organisateur : décorations de photo de profil
    // (statiques ou animées), thèmes personnalisés, tags de profil, jeux TCG
    // disponibles pour le Duel du jour / l'Événement. Tout le monde peut les
    // lire (nécessaire pour afficher les décorations/thèmes/tags des autres
    // joueurs, et pour remplir les listes de jeux) ; seul l'organisateur les
    // crée, les modifie ou les supprime. Un joueur qui référence encore une
    // décoration/un thème/un tag supprimé ne casse rien côté affichage
    // (l'appli ignore silencieusement une référence introuvable) — les jeux
    // restent non supprimables (déjà référencés par l'historique des
    // matchs/événements).
    // ========================================================================
    match /decorations/{decoId} {
      // Une décoration "non publiée" (nouvelle, en préparation) n'est lisible
      // que par l'organisateur — c'est la vraie garantie côté serveur que
      // "seul moi peut la voir" avant publication, en plus du filtrage côté
      // affichage (getAllDecorations() dans live-catalog.js). .get() avec
      // valeur par défaut "true" pour rester lisible par tous sur d'anciens
      // documents créés avant l'ajout de ce champ (jamais "published:false").
      allow read: if request.auth != null
        && (resource.data.get('published', true) == true || isOrganizer());
      allow create, update: if isOrganizer();
      // La suppression est permise (contrairement aux thèmes/tags plus bas,
      // c'est symétrique) : un joueur qui a encore une décoration supprimée
      // en "active" ne casse rien à l'affichage (voir renderAvatar en app.js,
      // qui ignore silencieusement une décoration introuvable).
      allow delete: if isOrganizer();
    }

    match /themes/{themeId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if isOrganizer();
    }

    // Fonds de profil : même fonctionnement que /decorations ci-dessus
    // (publié/non publié, suppression permise sans casser l'affichage d'un
    // joueur qui en avait un actif — voir applyProfileBackground dans
    // app.js, qui ignore silencieusement une référence introuvable).
    match /profileBgs/{bgId} {
      allow read: if request.auth != null
        && (resource.data.get('published', true) == true || isOrganizer());
      allow create, update: if isOrganizer();
      allow delete: if isOrganizer();
    }

    match /tags/{tagId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if isOrganizer();
    }

    // Titres personnalisés (affichés sous le pseudo) : même fonctionnement
    // que /profileBgs ci-dessus (publié/non publié, suppression permise sans
    // casser l'affichage d'un joueur qui en avait un actif — voir
    // titleBadgeHtml dans app.js, qui ignore silencieusement une référence
    // introuvable).
    match /titles/{titleId} {
      allow read: if request.auth != null
        && (resource.data.get('published', true) == true || isOrganizer());
      allow create, update: if isOrganizer();
      allow delete: if isOrganizer();
    }

    // Réglages globaux de l'appli (pour l'instant : uniquement le logo
    // personnalisé, document fixe "appSettings/main") — lisible par tout
    // compte connecté (comme tout le reste de l'appli, pas d'accès anonyme),
    // modifiable uniquement par l'organisateur.
    match /appSettings/{docId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if isOrganizer();
    }

    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create, update: if isOrganizer();
      allow delete: if false;
    }

    // ========================================================================
    // Saisons : périodes programmées (date de début / date de fin) pendant
    // lesquelles les joueurs gagnent des points via le Duel du jour — voir
    // js/season.js. Uniquement gérées par l'organisateur ; le calcul des
    // points/classement d'une saison se fait côté client à partir de
    // l'historique des duels déjà validés (dailySession/*/duels), jamais
    // stocké/incrémenté directement ici — voir la remarque de confiance
    // plus bas sur le tag de saison pour la seule exception.
    // ========================================================================
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isOrganizer();
    }

    // Points bonus manuels accordés par l'organisateur en dehors d'un duel
    // (ex. participation à un événement spécial) — voir js/season.js. Lus
    // par tout le monde (comme /seasons) car ils entrent dans le total à vie
    // et le classement de saison affichés à tous les joueurs ; jamais
    // modifiés une fois créés (montant/raison figés), seulement créés ou
    // supprimés par l'organisateur.
    match /pointAdjustments/{adjustmentId} {
      allow read: if request.auth != null;
      allow create, delete: if isOrganizer();
      allow update: if false;
    }

    // ========================================================================
    // "Duel du jour" — session de duels en boutique, gérée en direct.
    //
    //   dailySession/current                      -> statut de la soirée
    //   dailySession/current/participants/{uid}    -> présence + validation
    //   dailySession/current/duels/{duelId}        -> propositions + résultats
    // ========================================================================

    match /dailySession/{sessionId} {
      // Tout le monde peut voir si une session est ouverte / son heure de fin.
      allow read: if request.auth != null;
      // Seul l'organisateur ouvre / ferme la session (et fixe l'heure de fin).
      allow write: if isOrganizer();
    }

    match /dailySession/{sessionId}/participants/{uid} {
      allow read: if request.auth != null;

      // Un joueur ne peut créer que SA propre demande, toujours en attente de
      // validation par l'organisateur. L'organisateur peut créer directement
      // sa propre fiche déjà "disponible" (il n'a pas besoin de s'auto-valider).
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.status == 'attente_validation')
        || isOrganizer()
      );

      // L'organisateur gère tout (valider/refuser/exclure). Un joueur peut
      // seulement : se retirer lui-même ("Quitter le duel du jour"), sans
      // toucher à ses propres pseudo/photo/décorations affichés dans la
      // liste ; OU redemander à rejoindre après un départ / refus /
      // exclusion (repasse en attente de validation par l'organisateur).
      allow update: if isOrganizer() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && (
          (
            resource.data.status in ['attente_validation', 'disponible']
            && request.resource.data.status == 'parti'
            && request.resource.data.pseudo == resource.data.pseudo
            && request.resource.data.photoDataUrl == resource.data.photoDataUrl
            && request.resource.data.decorations == resource.data.decorations
          )
          ||
          (
            resource.data.status in ['parti', 'refuse', 'exclu']
            && request.resource.data.status == 'attente_validation'
          )
        )
      );

      allow delete: if isOrganizer();
    }

    // --------------------------------------------------------------------
    // Deck déclaré par un joueur pour un duel du jour (quel(s) élément(s) de
    // jeu il a joué — voir /games plus bas et js/live-catalog.js). Un
    // document à part (au lieu d'un simple champ sur le duel ci-dessous)
    // EXPRÈS : le duel lui-même est lisible par tous les comptes connectés
    // (nécessaire pour savoir qui est déjà occupé), donc un champ "deck"
    // directement dessus serait visible tout de suite — ce qui annulerait
    // le but ("éviter les contres") de cacher son deck à l'adversaire tant
    // que le duel n'est pas terminé. Toujours lisible par son titulaire et
    // par l'organisateur ; lisible par l'adversaire seulement une fois le
    // duel "termine". Jamais modifiable une fois déclaré (create only).
    // --------------------------------------------------------------------
    match /dailySession/{sessionId}/duels/{duelId}/decks/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || isOrganizer()
        || get(/databases/$(database)/documents/dailySession/$(sessionId)/duels/$(duelId)).data.status == 'termine'
      );
      allow create: if request.auth != null && request.auth.uid == uid
        && (
          get(/databases/$(database)/documents/dailySession/$(sessionId)/duels/$(duelId)).data.fromUid == uid
          || get(/databases/$(database)/documents/dailySession/$(sessionId)/duels/$(duelId)).data.toUid == uid
        )
        && request.resource.data.elements is list
        && request.resource.data.elements.size() >= 1
        && request.resource.data.elements.size() <= 4;
      allow update: if false;
      allow delete: if isOrganizer();
    }

    match /dailySession/{sessionId}/duels/{duelId} {
      // Lecture ouverte à tous les connectés : nécessaire pour que chacun
      // puisse calculer, côté client, qui est déjà occupé par un autre duel.
      allow read: if request.auth != null;

      // Seul l'auteur de la proposition peut la créer, ciblant quelqu'un
      // d'autre, sans résultat déjà rempli.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.status == 'proposition'
        && request.resource.data.resultFrom == null
        && request.resource.data.resultTo == null;

      allow update: if isOrganizer() || (
        // Le destinataire accepte ou refuse la proposition.
        request.auth != null && request.auth.uid == resource.data.toUid
        && resource.data.status == 'proposition'
        && request.resource.data.status in ['en_cours', 'refuse']
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.game == resource.data.game
        && request.resource.data.format == resource.data.format
        && request.resource.data.resultFrom == null
        && request.resource.data.resultTo == null
      ) || (
        // Le joueur "fromUid" saisit / corrige SON résultat uniquement.
        request.auth != null && request.auth.uid == resource.data.fromUid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.resultTo == resource.data.resultTo
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == (
             matchResults(request.resource.data.resultFrom, resource.data.resultTo)
               ? 'termine'
               : (resource.data.resultTo == null ? 'en_cours' : 'litige')
           )
      ) || (
        // Le joueur "toUid" saisit / corrige SON résultat uniquement.
        request.auth != null && request.auth.uid == resource.data.toUid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.resultFrom == resource.data.resultFrom
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == (
             matchResults(resource.data.resultFrom, request.resource.data.resultTo)
               ? 'termine'
               : (resource.data.resultFrom == null ? 'en_cours' : 'litige')
           )
      );

      allow delete: if isOrganizer();
    }

    // ========================================================================
    // "Événement" — tournoi façon suisse, géré en direct.
    //
    //   events/{eventId}                     -> config + statut de l'événement
    //   events/{eventId}/participants/{uid}   -> inscription + validation
    //   events/{eventId}/matches/{matchId}    -> appariements + résultats
    // ========================================================================

    match /events/{eventId} {
      // Tout le monde peut voir les événements (en cours ou passés, pour
      // l'historique).
      allow read: if request.auth != null;
      // Seul l'organisateur crée / démarre / fait avancer / termine un
      // événement.
      allow create, update, delete: if isOrganizer();
    }

    match /events/{eventId}/participants/{uid} {
      allow read: if request.auth != null;

      // Un joueur ne peut créer que SA propre inscription, toujours en
      // liste d'attente. L'organisateur peut inscrire directement quelqu'un
      // (déjà "inscrit").
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.status == 'liste_attente')
        || isOrganizer()
      );

      // Même logique que pour le Duel du jour : l'organisateur gère tout
      // (valider/refuser/exclure/attribuer une place finale) ; un joueur
      // peut seulement se retirer, ou redemander à s'inscrire après un
      // départ / refus / exclusion. Victoires/défaites ne sont jamais
      // stockées ici (calculées à partir de l'historique des matchs), donc
      // pas besoin de les protéger ; la place finale ("placement") ne doit
      // en revanche jamais bouger via une action joueur.
      allow update: if isOrganizer() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.placement == resource.data.placement
        && (
          (
            resource.data.status in ['liste_attente', 'inscrit']
            && request.resource.data.status == 'parti'
            && request.resource.data.pseudo == resource.data.pseudo
            && request.resource.data.photoDataUrl == resource.data.photoDataUrl
            && request.resource.data.decorations == resource.data.decorations
          )
          ||
          (
            resource.data.status in ['parti', 'refuse', 'exclu']
            && request.resource.data.status == 'liste_attente'
          )
        )
      );

      allow delete: if isOrganizer();
    }

    // Deck déclaré par un participant pour cet événement — même principe
    // que les decks du Duel du jour ci-dessus : un document à part (pas un
    // champ sur le participant, lui lisible par tous) pour rester caché aux
    // autres joueurs tant que l'événement n'est pas "termine". Toujours
    // lisible par son titulaire et par l'organisateur.
    match /events/{eventId}/participants/{uid}/deck/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || isOrganizer()
        || get(/databases/$(database)/documents/events/$(eventId)).data.status == 'termine'
      );
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.elements is list
        && request.resource.data.elements.size() >= 1
        && request.resource.data.elements.size() <= 4;
      allow update: if false;
      allow delete: if isOrganizer();
    }

    match /events/{eventId}/matches/{matchId} {
      // Lecture ouverte : nécessaire pour que chacun voie les appariements
      // et l'avancement du tournoi.
      allow read: if request.auth != null;

      // Les appariements ne sont créés que par l'organisateur (démarrage de
      // l'événement / manche suivante).
      allow create: if isOrganizer();

      allow update: if isOrganizer() || (
        // Le joueur 1 saisit / corrige SON tableau de résultats uniquement.
        request.auth != null && request.auth.uid == resource.data.player1Uid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.gamesResult2 == resource.data.gamesResult2
        && (
             request.resource.data.gamesResult1 == null
             || allGamesFilled(request.resource.data.gamesResult1, resource.data.gamesCount)
           )
        && request.resource.data.status == (
             allGamesMatch(request.resource.data.gamesResult1, resource.data.gamesResult2)
               ? 'termine'
               : (resource.data.gamesResult2 == null ? 'en_cours' : 'litige')
           )
      ) || (
        // Le joueur 2 saisit / corrige SON tableau de résultats uniquement.
        request.auth != null && request.auth.uid == resource.data.player2Uid
        && resource.data.status in ['en_cours', 'litige']
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.gamesResult1 == resource.data.gamesResult1
        && (
             request.resource.data.gamesResult2 == null
             || allGamesFilled(request.resource.data.gamesResult2, resource.data.gamesCount)
           )
        && request.resource.data.status == (
             allGamesMatch(resource.data.gamesResult1, request.resource.data.gamesResult2)
               ? 'termine'
               : (resource.data.gamesResult1 == null ? 'en_cours' : 'litige')
           )
      );

      allow delete: if isOrganizer();
    }

    // ========================================================================
    // Calendrier des tournois — annonces "date + jeu" totalement indépendantes
    // des vrais événements ci-dessus (Task #44) : pas de sous-collection, pas
    // de validation, juste un tableau "interested" (uids) que n'importe quel
    // compte connecté peut faire grossir/rétrécir d'une seule unité — la
    // sienne (voir onlyToggledOwnInterest plus haut).
    // ========================================================================
    match /calendarAnnouncements/{annId} {
      allow read: if request.auth != null;

      allow create: if isOrganizer()
        && request.resource.data.game is string
        && request.resource.data.date is string
        && request.resource.data.interested == [];

      allow update: if isOrganizer() || (
        request.auth != null && onlyToggledOwnInterest(request.auth.uid)
      );

      allow delete: if isOrganizer();
    }
  }
}
